{
  "name": "dsh-clawtouch",
  "version": "0.4.1",
  "description": "Real mouse and keyboard for a DeepSeek Harness agent: describe what to click in words, a model you pick in dsh finds it, a USB HID device clicks it.",
  "type": "module",
  "main": "index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.js && node --test client.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "gui-automation",
    "hid",
    "clawtouch",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinqiao-oss/clawtouch-mcp.git",
    "directory": "adapters/dsh/plugin"
  },
  "homepage": "https://github.com/tinqiao-oss/clawtouch-mcp/tree/master/adapters/dsh/plugin",
  "bugs": {
    "url": "https://github.com/tinqiao-oss/clawtouch-mcp/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-alpha.2"
  }
}
